# ──────────────────────────────────────────────
# API (NestJS backend)
# ──────────────────────────────────────────────

# PostgreSQL connection string (Docker container)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_control

# JWT secret for signing tokens (use a long random string in production)
JWT_SECRET=change-me-in-production

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# API port
PORT=3000

# ──────────────────────────────────────────────
# Frontend (app/ Vite React)
# ──────────────────────────────────────────────

# URL of the NestJS API
VITE_API_URL=http://localhost:3000
