# ──────────────────────────────────────────────
# Supabase (local o proyecto remoto)
# ──────────────────────────────────────────────

# URL del proyecto Supabase (ej: http://127.0.0.1:54321 para local)
SUPABASE_URL=http://127.0.0.1:54321

# Clave anon — usada en el frontend (RLS aplica). Obtener con: supabase status --workdir db
SUPABASE_ANON_KEY= 

# Clave service role — usada en el backend (bypassea RLS, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (Vite inyecta variables que empiezan con VITE_)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────
# OpenAI — clasificación automática
# ──────────────────────────────────────────────

OPENAI_API_KEY=

# ──────────────────────────────────────────────
# Twilio — webhook WhatsApp
# ──────────────────────────────────────────────

# Auth token de tu cuenta Twilio (para validar firmas)
TWILIO_AUTH_TOKEN=

# ──────────────────────────────────────────────
# API
# ──────────────────────────────────────────────

PORT=3000
