# ──────────────────────────────────────────────────────────────────────────────
# .env.production — Template de variables de entorno para PRODUCCIÓN
#
# INSTRUCCIONES:
#   1. Copia este archivo al servidor: scp .env.production deploy@192.168.1.212:~/expense-control/.env.production
#   2. En el servidor edita los valores marcados con CHANGE_ME
#   3. NUNCA comitas el archivo .env.production con valores reales al repositorio
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# URL que usa NestJS para conectarse al contenedor expense-db (hostname dentro de expense_network)
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@expense-db:5432/expense_control

# Puerto expuesto en el host para la BD (opcional, solo si necesitas acceso externo)
DB_PORT=5432

# ── NestJS API ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Secreto JWT — genera uno con: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# Origen permitido para CORS — debe coincidir con la URL donde sirves el frontend
FRONTEND_URL=http://192.168.1.212:3000

# ── Frontend React (Vite — se inyecta en BUILD TIME, no en runtime) ────────────
# URL pública del API, accesible desde el navegador del usuario
VITE_API_URL=http://192.168.1.212:3000/expense-api

# Path base del frontend en nginx (no cambiar salvo que cambies el context path)
VITE_BASE=/expense/
